<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Mis TODOs</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <main>
    <%- include('../partials/_header') %>

    <ul class="todo-list">
      <% todos.forEach(function(todo) { %>
        <li>
          <span><%= todo.title %></span>
        </li>
      <% }); %>
    </ul>
  </main>
</body>
</html>
