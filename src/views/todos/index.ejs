<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Mis TODOs</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <main>
    <h1>Mis TODOs</h1>
    <p><a href="/todos/nuevo">+ Nueva tarea</a></p>

    <% if (todos.length > 0) { %>
      <p class="empty">no hay tareas</p>
    <% } %>

    <ul class="todo-list">
      <% todos.forEach(function(x) { %>
        <li>
          <span><%= x.title %></span>
        </li>
      <% }); %>
    </ul>
  </main>
</body>
</html>
