<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Editar tarea</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <main>
    <h1>Editar tarea</h1>

    <form action="/todos/<%= todo.id %>/editar" method="POST">
      <label>
        Título
        <input type="text" name="title" value="<%= todo.title %>" autofocus />
      </label>
      <button type="submit">Guardar</button>
      <a href="/todos">Cancelar</a>
    </form>
  </main>
</body>
</html>
